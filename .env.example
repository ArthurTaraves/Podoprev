# Credenciais do projeto Firebase (Console Firebase > Configurações do projeto > Seus apps > SDK setup)
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# NUNCA versione o .env.local (já está no .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" somente se o projeto estiver no plano Blaze com Firebase Storage ativado.
# Deixe "false" (ou omita) para usar Auth + Firestore de graça, com fotos guardadas
# só localmente no navegador em vez de sincronizadas na nuvem.
VITE_FIREBASE_STORAGE_ENABLED=false
