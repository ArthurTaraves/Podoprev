rules_version = '2';

// Fotos ficam em patients/{patientId}/visits/{visitId}/{arquivo}.
// Qualquer profissional autenticado pode ler/gravar — a filtragem por dono
// acontece no Firestore (coleção `photos`), que é a fonte de verdade das
// permissões; o Storage aqui só exige autenticação e limite de tamanho/tipo.
service firebase.storage {
  match /b/{bucket}/o {
    match /patients/{patientId}/visits/{visitId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
